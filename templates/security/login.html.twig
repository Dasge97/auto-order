{% extends 'base.html.twig' %}

{% block title %}Entrar · Auto-order{% endblock %}

{% block layout %}
    <div class="login-wrap">
        <h1>Auto-order</h1>

        <div class="card">
            {% if error %}
                <div class="flash flash-error">Usuario o contraseña incorrectos.</div>
            {% endif %}

            <form method="post">
                <div class="field">
                    <label for="username">Usuario</label>
                    <input type="text" id="username" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>
                </div>

                <div class="field">
                    <label for="password">Contraseña</label>
                    <input type="password" id="password" name="_password" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="btn" type="submit">Entrar</button>
            </form>
        </div>
    </div>
{% endblock %}
